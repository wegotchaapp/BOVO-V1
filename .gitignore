# ── Dependencies ───────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build output ───────────────────────────────────────────────────────────
dist/
build/
out/
*.tsbuildinfo

# ── Environment / secrets ──────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem

# ── Local upload storage (dev fallback for S3) ──────────────────────────────
uploads/
/backend/private-media/
/private-media/

# ── Local Postgres cluster + DB artifacts (created for local bring-up) ──────
.pgdata/
*.sql.bak

# ── Local run / test scratch files ─────────────────────────────────────────
.run.log
.smoke.ps1
.admin-smoke.ps1
.pgtmp_mobile.sql

# ── Logs ───────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Expo / EAS (mobile) ────────────────────────────────────────────────────
.expo/
.expo-shared/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/

# ── Native (mobile) ────────────────────────────────────────────────────────
ios/
android/

# ── Testing / coverage ─────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Editor / OS ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# ── Agent tooling ──────────────────────────────────────────────────────────
# Vendored third-party agent skills, restorable from skills-lock.json via
# `npx skills add`. .claude/skills holds symlinks into .agents/, so the two
# must be ignored together or the committed links would dangle.
.agents/
.claude/skills/
.claude/settings.local.json
# Codex's local MCP/runtime config. Tracked config would dirty the tree every
# time the agent rewrites it, which muddies the diffs it is meant to produce.
.codex/
