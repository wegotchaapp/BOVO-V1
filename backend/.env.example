# === DATABASE ===
DATABASE_URL=postgresql://postgres:password@localhost:5432/wegotcha

# === REDIS ===
REDIS_URL=rediss://default:token@localhost:6379

# === SUPABASE ===
# Create a project at https://supabase.com, then find these in Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# === AUTH ===
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# Google OAuth (optional). Comma-separated client IDs accepted as token audience.
# Must match EXPO_PUBLIC_GOOGLE_CLIENT_ID used by the mobile app for /api/auth/oauth.
# GOOGLE_CLIENT_ID=123456789-abc.apps.googleusercontent.com
# Apple Sign-In Services ID / bundle ID used as token audience (optional).
# APPLE_CLIENT_ID=com.bovogo.app

# === STRIPE ===
# Required for mobile booking Payment Sheet (/api/bookings/prepare + confirm)
# and Travel+ subscriptions. Use Stripe test keys for local dev; production
# needs real ones. A key that is unset or still reads `mock`/`your-stripe` makes
# prepare/confirm answer "Payments are not configured". Booking callers must
# use the verified prepare/confirm flow. Never provide a free-booking fallback.
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
# One secret per Stripe endpoint, never shared. Each receiver verifies against
# only its own, so a signature minted for one endpoint is rejected by the
# others; reusing a single value across all three throws that away.
# /payments/webhook
STRIPE_WEBHOOK_SECRET=whsec_your-platform-webhook-secret
# /webhooks/stripe-connect
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_your-connect-webhook-secret
# /identity/webhook
STRIPE_IDENTITY_WEBHOOK_SECRET=whsec_your-identity-webhook-secret
# Recurring price id for "Bovogo Premium" ($22/mo). Used by the mobile
# subscription flow (/api/subscriptions/start). Leave blank to run the app
# with subscriptions disabled (the mobile screen handles this gracefully).
STRIPE_PRICE_ID=price_your-premium-monthly-price-id

# === TWILIO ===
TWILIO_ACCOUNT_SID=AC_your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+15551234567
TWILIO_VERIFY_SERVICE_SID=VA_your-verify-sid
# Masked-calling number for rider<->driver calls (optional; falls back to
# TWILIO_PHONE_NUMBER).
# TWILIO_PROXY_NUMBER=+15551234568
# Public https origin Twilio posts callbacks to, scheme + host only (e.g.
# https://api.bovogo.app). TwilioSignatureGuard appends the request path to it
# to rebuild the URL Twilio signed, rather than reading Host/X-Forwarded-Host,
# which a caller controls. A path, query or userinfo here therefore rebuilds
# the wrong URL and fails every genuine callback; scripts/write-deploy-env.cjs
# rejects those shapes. Unset means every Twilio callback 500s, so it has to be
# set wherever a Twilio webhook is registered.
TWILIO_WEBHOOK_BASE_URL=http://localhost:3000

# === MAPBOX ===
MAPBOX_ACCESS_TOKEN=pk.your-mapbox-token
MAPBOX_SECRET_TOKEN=sk.your-mapbox-secret-token

# === CHECKR ===
# Also the webhook signing key. Checkr signs webhooks with an HMAC-SHA256 keyed
# by the API key for ordinary API integrations, and by the OAuth client secret
# for Partner applications (docs.checkr.com, "Securing webhooks"). This
# integration authenticates with the API key (HTTP Basic, checkr.service.ts), so
# the API key is the expected signing key here.
CHECKR_API_KEY=your-checkr-api-key
# Verifies /api/background-check/webhook and /webhooks/checkr callbacks. Set
# this only if this account's webhooks are signed with something other than
# CHECKR_API_KEY — the receiver falls back to the API key when it is blank.
# Which one applies is an account fact; confirm it against the Checkr dashboard
# when the integration is provisioned rather than assuming either way.
CHECKR_WEBHOOK_SECRET=your-checkr-webhook-secret
CHECKR_API_URL=https://api.checkr-staging.com
# CHECKR_PACKAGE=driver_pro
# CHECKR_TIMEOUT_MS=15000

# === NOONLIGHT ===
NOONLIGHT_API_KEY=your-noonlight-api-key
NOONLIGHT_API_URL=https://api-sandbox.noonlight.com
# Verifies /safety/noonlight/webhook callbacks. Separate from the API key.
# REQUIRED in every environment, including local. The endpoint closes someone's
# live emergency alarm, so it refuses to process an unverified update anywhere
# and answers 503 while this is blank. Noonlight only issues the real value once
# a webhook URL is saved; until then any non-empty string both ends agree on
# will do for sandbox work.
NOONLIGHT_WEBHOOK_SECRET=your-noonlight-webhook-secret
# NOONLIGHT_TIMEOUT_MS=10000

# === RESEND ===
# Required for booking confirmation and pre-trip video emails (mobile API).
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=hello@wegotcha.com
# Optional deep links in emails (defaults to APP_URL or https://bovogo.app)
# MOBILE_APP_URL=https://bovogo.app

# === AWS ===
AWS_ACCESS_KEY_ID=AKIA_your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
# Private ID/selfie storage. Keep S3 public access blocked for this bucket.
# Without configured AWS credentials, the server uses ./private-media locally.
# Defaults to S3 in production; local storage is development-only.
# PRIVATE_MEDIA_DRIVER=s3
# AWS_SESSION_TOKEN= (required with temporary ASIA credentials)
PRIVATE_MEDIA_BUCKET=bovogo-private-media

# === APP ===
APP_ENV=development
APP_URL=http://localhost:3000
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,https://wegotcha.com
LOG_LEVEL=debug
# Number of reverse proxies Bovogo operates in front of this API. Only the
# right-most TRUST_PROXY_HOPS entries of X-Forwarded-For are trusted; anything
# further left came from the caller. 0 is correct for local development, where
# nothing sits in front of the process. In production it is REQUIRED and the
# server refuses to boot without it — the right value is a fact about the
# deployment (1 for a single Railway or Cloudflare edge, 2 when both are in
# the path), so it must be counted, never guessed.
TRUST_PROXY_HOPS=0
IRS_MILEAGE_RATE=0.67
