# Bovogo mobile (Expo) environment.
# Copy to `.env` for local dev. For EAS builds, these come from eas.json `env`.
# Restart Expo after changing any EXPO_PUBLIC_* value (they are baked at bundle time).

# Base URL of the Bovogo NestJS backend, WITHOUT a trailing /api.
# Local dev (Android emulator uses 10.0.2.2, physical device uses your LAN IP):
EXPO_PUBLIC_API_URL=http://localhost:3000

# Stripe publishable key (pk_test_... or pk_live_...).
# Required for booking Payment Sheet and Travel+ on device.
# Backend also returns this from /api/bookings/prepare and /api/subscriptions/config.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# Mapbox public token (pk.eyJ...). Required for live tracking map tiles.
# Without a real token the map shows "Map unavailable" instead of a blank screen.
EXPO_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-token

# Google Sign-In (OAuth 2.0 Web client ID from Google Cloud Console).
# Optional — buttons show a setup message when missing.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
# Optional platform-specific client IDs (fall back to the web client ID):
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
